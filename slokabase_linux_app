#!/usr/bin/env bash

# bash Script Info:  It is  Dockerized CLI wrapper with cleanup for Slokabase

# sudo cp slokabase_linux_app /usr/local/bin/slokabase      # : move file to local/bin/ and change file name
# sudo cp slokabase_linux_app ~/.local/bin/slokabase        # : move file to home local bin and change file
# cd to the file 

# chmod +x slokabase_linux_app                              # : make this file executable 

# Now you can run app from anywhere in cli 
# >>> slokabase # run in terminal


# Docker run 
      # docker run -it --name sloka_con1 -p 5000:5000 slokabase_img
# Docker run with persistance storage
      # docker run -it --name sloka_con -v /media/karthik/myVolume/SlokaBase_App/slokabase/database:/app/database -p 5000:5000 slokabase_img 


IMAGE="slokabase_img:latest"
CONTAINER_NAME="slokabase_temp_$(date +%s)"

# --- Check Docker ---
if ! command -v docker &>/dev/null; then
  echo "❌ Docker is required but not installed." >&2
  exit 1
fi

# --- Detect TTY (interactive vs. piped mode) ---
if [ -t 1 ]; then
  TTY_FLAGS="-it"
else
  TTY_FLAGS="-i"
fi

# --- Cleanup function ---
cleanup() {
  echo "🧹 Cleaning up container..."
  docker kill "$CONTAINER_NAME" >/dev/null 2>&1 || true
  docker rm "$CONTAINER_NAME" >/dev/null 2>&1 || true
}
trap cleanup EXIT INT TERM



docker run $TTY_FLAGS \
  --name "$CONTAINER_NAME" \
  -p 5000:5000 \
  --rm=false \
  $IMAGE "$@"

# -v "$PWD":/app \
  # -w /app \
  # -u "$(id -u):$(id -g)" \

# prevents Docker from auto-removing the container so you can kill it explicitly 
# (you could still use --rm if you prefer not to inspect the container before removal).
# -v "$(pwd)":/app → mounts your current directory into /app inside the container
# -w /app → sets working directory inside container
# "$@" → passes all CLI arguments to your container command


#  Note: you can move file below location 

# | Goal                | Path              | Requires sudo | Visible to |
# |-----                |------             |------------   |-------------|
# | All users           | `/usr/local/bin`  | ✅ Yes        | Everyone |
# | Only you            | `~/.local/bin`    | ❌ No         | Current user |
# | System packages     | `/usr/bin`        | ✅ Yes        | Everyone |
# | App-style install   | `/opt/<appname>/bin` | ✅ Yes     | Everyone |
# | Old-school scripts  | `~/bin`           | ❌ No         | Current user |